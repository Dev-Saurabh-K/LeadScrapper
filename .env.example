# ==============================================================================
# B2B Lead Scraper - Environment Template (.env.example)
# Copy this file to .env and fill in your actual credentials.
# NEVER commit .env to version control!
# ==============================================================================

# Supabase (PostgreSQL) Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-ID].supabase.co:5432/postgres

# Registry API Keys (Optional - Free Public Registries like Norway, France, SG, USA don't need keys)
# UK Companies House: Register free at developer.companyinformation.service.gov.uk
COMPANIES_HOUSE_API_KEY=
# Australia ABN Lookup: Register free GUID at abr.business.gov.au
ABN_LOOKUP_GUID=

# Email SMTP Notification Configuration (Job Completion Summaries)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="B2B Lead Scraper <your-email@gmail.com>"
NOTIFICATION_EMAIL_TO=your-manager-or-sales@example.com

# Scraper Polite Compliance Settings
SCRAPER_USER_AGENT="B2BLeadScraper/1.0 (+https://github.com/the-corent/leadscrape; contact@example.com)"
SCRAPER_DEFAULT_DELAY_MS=1000
